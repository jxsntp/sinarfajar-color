APP_ENV=development
DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:25422/inaura_dev
DIRECT_URL=postgresql://postgres:local-development-only@127.0.0.1:25422/inaura_dev
SUPABASE_URL=http://127.0.0.1:25421
SUPABASE_PUBLISHABLE_KEY=local-auth-gateway-development-key
CLIENT_SLUG=sinar-fajar
REPORT_TTL_DAYS=30
KIOSK_SESSION_MINUTES=15
ENABLE_MOBILE_REPORTS=true

# Optional for hosted product photography and paid mobile activation
# SUPABASE_STORAGE_KEY=
# OPENROUTER_API_KEY=
ENABLE_HOSTED_OPENROUTER=false
OPENROUTER_MODELS=
OPENROUTER_PROVIDERS=
# Optional. Select a vision-capable model and provider included in the allowlists above.
OPENROUTER_VISION_MODEL=
OPENROUTER_VISION_PROVIDER=
AI_TIMEOUT_MS=3000
AI_MAX_OUTPUT_TOKENS=650
AI_MAX_ATTEMPTS=2
AI_DAILY_REQUESTS=100
AI_DAILY_USD=2
AI_RUN_USD=0.019
AI_PROMPT_USD_PER_M=0.5
AI_COMPLETION_USD_PER_M=2

# Use your deployed HTTPS origin for UAT and production.
REPORT_ORIGIN=http://localhost:3000
# PUBLIC_SOCIAL_URL=https://www.instagram.com/your-approved-profile/


# Phase 4 sales-attribution window from kiosk start to the recorded sale
ATTRIBUTION_WINDOW_MINUTES=180
# Optional alert delivery. Use a trusted HTTPS n8n endpoint.
# OPS_N8N_WEBHOOK=
# OPS_N8N_TOKEN=
# OPS_N8N_SIGNING_KEY=
# OPS_JOB_TOKEN= (local compatibility only)

# Phase 6. Use unrelated generated values in each hosted environment.
# APP_ORIGIN=https://uat.example.com
# SECURITY_KEY=
# INBOUND_JOB_SECRET=
# MONITOR_TOKEN=
DEVICE_TTL_DAYS=180
CUSTOMER_RETENTION_DAYS=30
PRIVACY_AUDIT_RETENTION_DAYS=90
MONITOR_DAILY_USD=2
# Hosted environments must set an approved inventory freshness window.
# INVENTORY_MAX_AGE_MINUTES=60
# Use INVENTORY_MAX_AGE_MINUTES=off to disable the age cutoff explicitly.

# Optional bench features for development or UAT
# COLOR_STATIONS={}
